# Copie para .env e ajuste. Todas são opcionais; os valores abaixo são os padrões.

# Chave exigida no cabeçalho X-API-Key de POST /consultas. Sem ela, a API fica aberta
# (só para uso local). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ROBO_API_KEY=
PORTAL_URL_BASE=https://portaldatransparencia.gov.br
ROBO_HEADLESS=true
# Tempo máximo de uma consulta inteira (busca + panorama + detalhes), em segundos
ROBO_TIMEOUT_CONSULTA_S=180
# Tempo máximo de cada ação do navegador, em milissegundos
ROBO_TIMEOUT_ACAO_MS=30000
# Consultas usando o navegador ao mesmo tempo; as demais esperam na fila
ROBO_MAX_SIMULTANEAS=3
# Linhas pedidas por página nas tabelas de parcelas dos benefícios
ROBO_TAMANHO_PAGINA_DETALHE=200
# Quanto esperar a verificação silenciosa do WAF se resolver sozinha, em segundos
ROBO_ESPERA_VERIFICACAO_S=8
